{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PelotonicReaction workout v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "description": "Admin-owned labels configured in the deployed catalog; read-only in the browser.",
      "type": "array",
      "maxItems": 20,
      "examples": [
        [
          "Tabata",
          "Intervals"
        ],
        [
          "Endurance",
          "Power Zone"
        ],
        [
          "Beginner",
          "Low Impact"
        ]
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "\\S"
      }
    },
    "source": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "userTags": {
      "description": "Portable user-tag names exported from a browser profile. Imports create user tags, never admin tags.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "\\S"
      }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "label",
            "durationSeconds"
          ],
          "not": {
            "required": [
              "repeat"
            ]
          },
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "kind": {
              "enum": [
                "warmup",
                "work",
                "recovery",
                "cooldown"
              ]
            },
            "cadence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 200
            },
            "resistance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "watts": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 3000
            },
            "heartRate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 30,
              "maximum": 240,
              "description": "Target heart rate in BPM; no age-based zones are inferred."
            },
            "targetRanges": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cadence": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 200
                  }
                },
                "resistance": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "watts": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3000
                  }
                },
                "heartRate": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 30,
                    "maximum": 240
                  }
                }
              },
              "description": "Explicit inclusive [low, high] segment ranges; override single-value targets for live gauges."
            },
            "posture": {
              "enum": [
                "seated",
                "standing",
                null
              ],
              "description": "Rider posture cue; null or omitted leaves posture unspecified."
            },
            "powerZone": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 7,
              "description": "Power-zone cue. When watts is also supplied, watts is the precise guidance target and the zone is a reference cue. Mutually exclusive with targetRanges.watts."
            },
            "primaryTargets": {
              "type": [
                "array",
                "null"
              ],
              "uniqueItems": true,
              "items": {
                "enum": [
                  "cadence",
                  "resistance",
                  "watts",
                  "heartRate"
                ]
              },
              "description": "Only these metrics generate correction arrows/colors. Use watts for a powerZone target. Omitted, null or [] means reference targets only."
            },
            "heartRateZone": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 5,
              "description": "HR zone resolved from rider profile (Strava zones first, local fallback). Mutually exclusive with heartRate and targetRanges.heartRate. Use heartRate in primaryTargets for guidance."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "repeat",
            "steps"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "repeat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          }
        }
      ]
    }
  }
}
