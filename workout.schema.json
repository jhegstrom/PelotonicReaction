{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PelotonicReaction workout v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "description": "Admin-owned labels configured in the deployed catalog; read-only in the browser.",
      "type": "array",
      "maxItems": 20,
      "examples": [
        [
          "Tabata",
          "Intervals"
        ],
        [
          "Endurance",
          "Power Zone"
        ],
        [
          "Beginner",
          "Low Impact"
        ]
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "\\S"
      }
    },
    "source": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "userTags": {
      "description": "Portable user-tag names exported from a browser profile. Imports create user tags, never admin tags.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60,
        "pattern": "\\S"
      }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "label",
            "durationSeconds"
          ],
          "not": {
            "required": [
              "repeat"
            ]
          },
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "kind": {
              "enum": [
                "warmup",
                "work",
                "recovery",
                "cooldown"
              ]
            },
            "cadence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 200
            },
            "resistance": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "watts": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 3000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "repeat",
            "steps"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "repeat": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          }
        }
      ]
    }
  }
}
